<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ConfigForge.Core</PackageId>
    <Description>Schema parsing, document engine, and plugin host for ConfigForge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ConfigForge.Abstractions/ConfigForge.Abstractions.csproj" />
    <ProjectReference Include="../ConfigForge.Core.CapabilityProxy/ConfigForge.Core.CapabilityProxy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="9.0.0"
    />
  </ItemGroup>

  <!--
    CapabilityLoader loads a second, private copy of ConfigForge.Core.CapabilityProxy.dll into
    each capability assembly's own collectible AssemblyLoadContext (see CapabilityLoader.
    CapabilityLoadContext.GetProxyBaseType) — DispatchProxy.Create's generated type is only
    collectible when its base type's assembly is, and the capability interface always is. The
    normal ProjectReference above still applies too, for typeof(RemoteCapabilityDispatchProxy).
  -->
  <ItemGroup>
    <EmbeddedResource
      Include="../ConfigForge.Core.CapabilityProxy/bin/$(Configuration)/net10.0/ConfigForge.Core.CapabilityProxy.dll"
      LogicalName="ConfigForge.Core.CapabilityProxy.dll"
      Link="ConfigForge.Core.CapabilityProxy.dll"
    />
  </ItemGroup>
</Project>
