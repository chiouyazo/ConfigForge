<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      netstandard2.0 is carried so .NET Framework hosts can annotate their configuration model with
      the [Cf*] attributes directly. Only these contracts have to reach them; the schema generator
      and the Blazor UI stay net10.0.
    -->
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>

    <PackageId>ConfigForge.Abstractions</PackageId>
    <Description>Public contracts for authoring ConfigForge plugins.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
