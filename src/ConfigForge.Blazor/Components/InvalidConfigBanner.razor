@using ConfigForge.Blazor.Services

@if (HasProblems)
{
    <div class="cf-banner cf-banner-danger" role="alert">
        <strong class="cf-banner-title">This configuration is not valid.</strong>
        @if (!string.IsNullOrEmpty(ParseResult!.JsonError))
        {
            <p class="cf-banner-line">The document could not be parsed: @ParseResult.JsonError</p>
        }
        @if (VisibleMissing.Count > 0)
        {
            <div class="cf-banner-section">
                <span>Missing required fields:</span>
                <ul>
                    @foreach (string key in VisibleMissing)
                    {
                        <li>@key</li>
                    }
                </ul>
            </div>
        }
        @if (VisibleInvalid.Count > 0)
        {
            <div class="cf-banner-section">
                <span>Invalid values:</span>
                <ul>
                    @foreach (ValidationError error in VisibleInvalid)
                    {
                        <li><code>@error.Key</code>: @error.Message</li>
                    }
                </ul>
            </div>
        }
    </div>
}

@code {
    /// <summary>The parse result whose problems are summarised.</summary>
    [Parameter]
    public ConfigDocumentParseResult? ParseResult { get; set; }

    [Inject]
    private EditingSession Session { get; set; } = default!;

    private IReadOnlyList<string> VisibleMissing =>
        ParseResult is null
            ? []
            : [.. ParseResult.MissingRequiredKeys.Where(Session.ShouldShowError)];

    private IReadOnlyList<ValidationError> VisibleInvalid =>
        ParseResult is null
            ? []
            : [.. ParseResult.InvalidValues.Where(e => Session.ShouldShowError(e.Key))];

    private bool HasProblems =>
        ParseResult is not null
        && (!string.IsNullOrEmpty(ParseResult.JsonError)
            || VisibleMissing.Count > 0
            || VisibleInvalid.Count > 0);
}
