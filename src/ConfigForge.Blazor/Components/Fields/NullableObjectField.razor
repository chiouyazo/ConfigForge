@using ConfigForge.Abstractions
@using ConfigForge.Core.Schema

<div class="cf-field cf-nullable-object">
    <div class="cf-nullable-object-header">
        <label class="cf-nullable-object-toggle">
            <input type="checkbox"
                   checked="@Enabled"
                   disabled="@Disabled"
                   @onchange="@(e => Toggle(e.Value is true))" />
            <FieldLabel Control="Header" />
        </label>
        <FieldDescription Control="Header" />
    </div>

    @if (Enabled)
    {
        <div class="cf-nullable-object-body">
            @foreach (FieldDefinition child in Field.Children.Where(c => string.IsNullOrEmpty(c.Section)))
            {
                <FieldRenderer Field="RebaseChild(child)" Disabled="Disabled" />
            }

            @if (Sections.Count > 1)
            {
                <div class="cf-tabs">
                    <div class="cf-tab-strip" role="tablist">
                        @foreach (string section in Sections)
                        {
                            string s = section;
                            <button type="button"
                                    role="tab"
                                    aria-selected="@(s == ActiveSection ? "true" : "false")"
                                    class="cf-tab @(s == ActiveSection ? "cf-active" : string.Empty)"
                                    @onclick="@(() => Session.SetSelectedSection(Field.Key, s))">
                                @s
                            </button>
                        }
                    </div>
                    <div class="cf-tab-panel" role="tabpanel">
                        @foreach (FieldDefinition child in Field.Children.Where(c => c.Section == ActiveSection))
                        {
                            <FieldRenderer Field="RebaseChild(child)" Disabled="Disabled" />
                        }
                    </div>
                </div>
            }
            else
            {
                @foreach (FieldDefinition child in Field.Children.Where(c => !string.IsNullOrEmpty(c.Section)))
                {
                    <FieldRenderer Field="RebaseChild(child)" Disabled="Disabled" />
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>The nullable object field definition, carrying its child fields.</summary>
    [Parameter]
    [EditorRequired]
    public FieldDefinition Field { get; set; } = new();

    /// <summary>True when the control must not be edited.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    [Inject]
    private EditingSession Session { get; set; } = default!;

    /// <summary>Enabled when the stored value is a present object (not null / absent).</summary>
    private bool Enabled => Session.Document[Field.Key] is IDictionary<string, object?>;

    private List<string> Sections =>
        [.. Field.Children
            .Select(c => c.Section)
            .Where(s => !string.IsNullOrEmpty(s))
            .Select(s => s!)
            .Distinct(StringComparer.Ordinal)];

    private string? ActiveSection =>
        Session.GetSelectedSection(Field.Key) is { } stored && Sections.Contains(stored)
            ? stored
            : Sections.FirstOrDefault();

    private ControlDescriptor Header =>
        new()
        {
            Key = Field.Key,
            ControlType = Field.ControlType,
            Title = Field.Title,
            Description = Field.Description,
            Tooltip = Field.Tooltip,
            Required = Field.Required,
        };

    private FieldDefinition RebaseChild(FieldDefinition child) =>
        child.WithKey($"{Field.Key}/{child.Key}");

    private void Toggle(bool enable)
    {
        // Off removes the key rather than storing null: "not set" and "absent" are the same thing,
        // and a stored null would fail the field's own object-type validation.
        if (enable)
        {
            Session.SetFieldValue(
                Field.Key,
                new Dictionary<string, object?>(StringComparer.Ordinal)
            );
        }
        else
        {
            Session.RemoveFieldValue(Field.Key);
        }
    }
}
