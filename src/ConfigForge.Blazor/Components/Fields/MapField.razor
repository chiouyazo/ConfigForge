@using ConfigForge.Abstractions
@using ConfigForge.Core.Schema

<div class="cf-field cf-map">
    <FieldLabel Control="Header" />
    <FieldDescription Control="Header" />

    @{
        List<string> keys = ReadKeys();
    }

    @if (Complex)
    {
        @* Master/detail: entries listed on the left, the selected entry edited on the right. *@
        <div class="cf-map-md">
            <div class="cf-map-master">
                @if (keys.Count == 0)
                {
                    <p class="cf-map-empty">No entries yet.</p>
                }
                @foreach (string entryKey in keys)
                {
                    string key = entryKey;
                    <button type="button"
                            class="cf-map-nav-item @(string.Equals(key, SelectedKey, StringComparison.Ordinal) ? "cf-map-nav-active" : string.Empty)"
                            @onclick="@(() => SelectedKey = key)">
                        @EntryLabel(key)
                    </button>
                }
                @if (!Disabled)
                {
                    <button type="button" class="cf-button cf-map-add" @onclick="AddEntry">
                        Add entry
                    </button>
                }
            </div>
            <div class="cf-map-detail">
                @if (SelectedKey is { } sel && keys.Contains(sel))
                {
                    @if (!Keyless)
                    {
                        <input class="cf-input cf-map-key"
                               type="text"
                               value="@sel"
                               placeholder="Key"
                               disabled="@Disabled"
                               @onchange="@(e => RenameKey(sel, e.Value as string))" />
                    }
                    <div class="cf-map-value">
                        @if (IsObjectValue)
                        {
                            @foreach (FieldDefinition child in ValueChildren)
                            {
                                <FieldRenderer Field="RebaseChild(child, sel)" Disabled="Disabled" />
                            }
                        }
                        else
                        {
                            <FieldRenderer Field="RebaseValue(sel)" Disabled="Disabled" />
                        }
                    </div>
                    @if (!Disabled)
                    {
                        <button type="button"
                                class="cf-button cf-button-danger cf-map-remove"
                                @onclick="@(() => RemoveKey(sel))">
                            Remove
                        </button>
                    }
                }
                else
                {
                    <p class="cf-map-empty">Select an entry to edit, or add one.</p>
                }
            </div>
        </div>
    }
    else
    {
        @if (keys.Count == 0)
        {
            <p class="cf-map-empty">No entries yet.</p>
        }

        @foreach (string entryKey in keys)
        {
            string key = entryKey;
            <div class="cf-map-row @(Keyless ? "cf-map-row-keyless" : string.Empty)">
                @if (!Keyless)
                {
                    <input class="cf-input cf-map-key"
                           type="text"
                           value="@key"
                           placeholder="Key"
                           disabled="@Disabled"
                           @onchange="@(e => RenameKey(key, e.Value as string))" />
                }
                <div class="cf-map-value">
                    <FieldRenderer Field="RebaseValue(key)" Disabled="Disabled" />
                </div>
                @if (!Disabled)
                {
                    <button type="button"
                            class="cf-button cf-button-danger cf-map-remove"
                            @onclick="@(() => RemoveKey(key))">
                        Remove
                    </button>
                }
            </div>
        }

        @if (!Disabled)
        {
            <button type="button" class="cf-button cf-map-add" @onclick="AddEntry">
                Add entry
            </button>
        }
    }
</div>

@code {
    /// <summary>The map field definition, carrying the value template.</summary>
    [Parameter]
    [EditorRequired]
    public FieldDefinition Field { get; set; } = new();

    /// <summary>True when the control must not be edited.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    [Inject]
    private EditingSession Session { get; set; } = default!;

    /// <summary>The entry shown in the detail pane (master/detail mode only).</summary>
    private string? SelectedKey { get; set; }

    protected override void OnParametersSet()
    {
        List<string> keys = ReadKeys();
        if (SelectedKey is null || !keys.Contains(SelectedKey))
        {
            SelectedKey = keys.Count > 0 ? keys[0] : null;
        }
    }

    private ControlDescriptor Header =>
        new()
        {
            Key = Field.Key,
            ControlType = Field.ControlType,
            Title = Field.Title,
            Description = Field.Description,
            Tooltip = Field.Tooltip,
            Required = Field.Required,
        };

    private FieldDefinition ValueTemplate => Field.ValueField ?? new FieldDefinition { ControlType = "text" };

    private bool IsObjectValue => string.Equals(ValueTemplate.ControlType, "object", StringComparison.Ordinal);

    private bool IsOneOfValue => string.Equals(ValueTemplate.ControlType, "oneof", StringComparison.Ordinal);

    /// <summary>Complex entries (objects or polymorphic variants) get the master/detail layout.</summary>
    private bool Complex => IsObjectValue || IsOneOfValue;

    /// <summary>True when entries are keyed by a generated GUID the user never sees.</summary>
    private bool Keyless => string.Equals(Field.KeyFormat, "uuid", StringComparison.Ordinal);

    private IReadOnlyList<FieldDefinition> ValueChildren => ValueTemplate.Children;

    private FieldDefinition RebaseChild(FieldDefinition child, string key) =>
        child.WithKey($"{Field.Key}/{key}/{child.Key}");

    private FieldDefinition RebaseValue(string key) => ValueTemplate.WithKey($"{Field.Key}/{key}");

    private Dictionary<string, object?> ReadMap() =>
        Session.Document[Field.Key] is IDictionary<string, object?> map
            ? new Dictionary<string, object?>(map, StringComparer.Ordinal)
            : new Dictionary<string, object?>(StringComparer.Ordinal);

    private List<string> ReadKeys() => [.. ReadMap().Keys];

    /// <summary>
    /// Label shown for an entry in the master list: the key for keyed maps, otherwise the entry's
    /// name-like field, then its discriminator, then a positional fallback.
    /// </summary>
    private string EntryLabel(string key)
    {
        if (!Keyless)
        {
            return key;
        }

        if (ReadMap().TryGetValue(key, out object? value) && value is IDictionary<string, object?> entry)
        {
            foreach (string nameKey in new[] { "name", "displayName", "label", "title" })
            {
                if (entry.TryGetValue(nameKey, out object? nv) && nv is string s && s.Length > 0)
                {
                    return s;
                }
            }

            string? discriminator = ValueTemplate.DiscriminatorKey;
            if (
                !string.IsNullOrEmpty(discriminator)
                && entry.TryGetValue(discriminator, out object? dv)
                && dv is string ds
                && ds.Length > 0
            )
            {
                return ds;
            }
        }

        return $"Entry {ReadKeys().IndexOf(key) + 1}";
    }

    private void AddEntry()
    {
        Session.AddMapEntry(
            Field.Key,
            Keyless,
            IsObjectValue ? new Dictionary<string, object?>(StringComparer.Ordinal) : null
        );
        // Select the newly added entry so the detail pane shows it immediately.
        List<string> keys = ReadKeys();
        if (keys.Count > 0)
        {
            SelectedKey = keys[^1];
        }
    }

    private void RemoveKey(string key)
    {
        Session.RemoveMapEntry(Field.Key, key);
        if (string.Equals(SelectedKey, key, StringComparison.Ordinal))
        {
            List<string> keys = ReadKeys();
            SelectedKey = keys.Count > 0 ? keys[0] : null;
        }
    }

    private void RenameKey(string oldKey, string? rawNewKey)
    {
        string newKey = (rawNewKey ?? string.Empty).Trim();
        Dictionary<string, object?> source = ReadMap();
        if (
            newKey.Length == 0
            || string.Equals(oldKey, newKey, StringComparison.Ordinal)
            || source.ContainsKey(newKey)
        )
        {
            return;
        }

        Dictionary<string, object?> renamed = new(StringComparer.Ordinal);
        foreach (KeyValuePair<string, object?> entry in source)
        {
            renamed[string.Equals(entry.Key, oldKey, StringComparison.Ordinal) ? newKey : entry.Key] =
                entry.Value;
        }

        Session.SetFieldValue(Field.Key, renamed);
        if (string.Equals(SelectedKey, oldKey, StringComparison.Ordinal))
        {
            SelectedKey = newKey;
        }
    }
}
