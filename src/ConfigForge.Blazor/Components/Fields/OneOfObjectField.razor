@using ConfigForge.Abstractions
@using ConfigForge.Core.Schema

<div class="cf-field cf-oneof">
    <FieldLabel Control="Header" />
    <FieldDescription Control="Header" />

    <select class="cf-input cf-select cf-oneof-select"
            value="@ActiveVariant?.DiscriminatorValue"
            disabled="@Disabled"
            @onchange="OnVariantChangedAsync">
        @foreach (OneOfVariant variant in Field.OneOfVariants)
        {
            <option value="@variant.DiscriminatorValue">@variant.Label</option>
        }
    </select>

    @{
        OneOfVariant? active = ActiveVariant;
        List<string> visibleSections = active is null ? [] : VisibleSections(active);
        string? activeSection = active is null ? null : UsableActiveSection(active, visibleSections);
    }
    @if (active is not null)
    {
        <div class="cf-oneof-body">
            @* Fields without a section render first; sectioned fields become tabs. *@
            @foreach (FieldDefinition child in active.Children.Where(c => string.IsNullOrEmpty(c.Section)))
            {
                FieldDefinition scoped = child.WithKey(ChildKey(child));
                <FieldRenderer Field="scoped" Disabled="Disabled" />
            }

            @if (visibleSections.Count > 1)
            {
                <div class="cf-tabs">
                    <div class="cf-tab-strip" role="tablist">
                        @foreach (string section in visibleSections)
                        {
                            string s = section;
                            bool enabled = SectionState(active, s).Enabled;
                            <button type="button"
                                    role="tab"
                                    aria-selected="@(s == activeSection ? "true" : "false")"
                                    disabled="@(!enabled)"
                                    title="@(enabled ? null : "Locked")"
                                    class="cf-tab @(s == activeSection ? "cf-active" : string.Empty) @(enabled ? string.Empty : "cf-disabled")"
                                    @onclick="@(() => _activeSection = s)">
                                @s
                            </button>
                        }
                    </div>
                    <div class="cf-tab-panel" role="tabpanel">
                        @if (activeSection is not null)
                        {
                            @foreach (FieldDefinition child in active.Children.Where(c => c.Section == activeSection))
                            {
                                FieldDefinition scoped = child.WithKey(ChildKey(child));
                                <FieldRenderer Field="scoped" Disabled="Disabled" />
                            }
                        }
                    </div>
                </div>
            }
            else if (activeSection is not null)
            {
                @* A single usable section needs no tab strip: render its fields directly. *@
                @foreach (FieldDefinition child in active.Children.Where(c => c.Section == activeSection))
                {
                    FieldDefinition scoped = child.WithKey(ChildKey(child));
                    <FieldRenderer Field="scoped" Disabled="Disabled" />
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>The oneof field definition, carrying the discriminator and variants.</summary>
    [Parameter]
    [EditorRequired]
    public FieldDefinition Field { get; set; } = new();

    /// <summary>True when the control must not be edited.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    [Inject]
    private EditingSession Session { get; set; } = default!;

    [Inject]
    private IJsonFormsRuleEvaluator RuleEvaluator { get; set; } = default!;

    private string? _activeSection;

    private (bool Visible, bool Enabled) SectionState(OneOfVariant variant, string section) =>
        variant.SectionRules.TryGetValue(section, out IReadOnlyList<JsonFormsRule>? rules)
        && rules.Count > 0
            ? RuleEvaluation.Resolve(rules, RuleEvaluator, Session.Document, Field.Key)
            : (true, true);

    private List<string> VisibleSections(OneOfVariant variant) =>
        [.. Sections(variant).Where(s => SectionState(variant, s).Visible)];

    private string? UsableActiveSection(OneOfVariant variant, List<string> visibleSections)
    {
        if (
            _activeSection is not null
            && visibleSections.Contains(_activeSection)
            && SectionState(variant, _activeSection).Enabled
        )
        {
            return _activeSection;
        }

        return visibleSections.FirstOrDefault(s => SectionState(variant, s).Enabled);
    }

    protected override void OnParametersSet()
    {
        // A freshly added entry has no discriminator yet, so the dropdown only *shows* the first
        // variant without it being stored. Persist that default so the value is always a valid
        // variant (otherwise saving fails: "must specify a type discriminator").
        if (Disabled || Field.DiscriminatorKey is null)
        {
            return;
        }

        IDictionary<string, object?>? current =
            Session.Document[Field.Key] as IDictionary<string, object?>;
        bool hasDiscriminator =
            current is not null
            && current.TryGetValue(Field.DiscriminatorKey, out object? raw)
            && raw is string existing
            && existing.Length > 0;
        if (hasDiscriminator || Field.OneOfVariants.Count == 0)
        {
            return;
        }

        Dictionary<string, object?> obj =
            current is not null
                ? new Dictionary<string, object?>(current, StringComparer.Ordinal)
                : new Dictionary<string, object?>(StringComparer.Ordinal);
        obj[Field.DiscriminatorKey] = Field.OneOfVariants[0].DiscriminatorValue;
        Session.SetFieldValue(Field.Key, obj);
    }

    private static List<string> Sections(OneOfVariant? variant) =>
        variant is null
            ? []
            : [.. variant.Children
                .Select(c => c.Section)
                .Where(s => !string.IsNullOrEmpty(s))
                .Select(s => s!)
                .Distinct(StringComparer.Ordinal)];

    private string ChildKey(FieldDefinition child) => JsonFormsScope.JoinKey(Field.Key, child.Key);

    private ControlDescriptor Header =>
        new()
        {
            Key = Field.Key,
            ControlType = Field.ControlType,
            Title = Field.Title,
            Description = Field.Description,
            Tooltip = Field.Tooltip,
            Required = Field.Required,
        };

    private OneOfVariant? ActiveVariant
    {
        get
        {
            string? current = null;
            if (
                Field.DiscriminatorKey is not null
                && Session.Document[Field.Key] is IDictionary<string, object?> value
                && value.TryGetValue(Field.DiscriminatorKey, out object? raw)
            )
            {
                current = raw as string;
            }

            return Field.OneOfVariants.FirstOrDefault(v =>
                    string.Equals(v.DiscriminatorValue, current, StringComparison.Ordinal)
                ) ?? Field.OneOfVariants.FirstOrDefault();
        }
    }

    private void OnVariantChangedAsync(ChangeEventArgs e)
    {
        // Switching the discriminator resets the object to just that type; the new
        // variant's fields start empty rather than carrying the previous shape's values.
        Dictionary<string, object?> obj = new(StringComparer.Ordinal);
        if (Field.DiscriminatorKey is not null && e.Value is string disc)
        {
            obj[Field.DiscriminatorKey] = disc;
        }

        Session.SetFieldValue(Field.Key, obj);
    }
}
