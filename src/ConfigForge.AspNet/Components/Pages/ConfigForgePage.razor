@page "/"
@page "/config-ui"
@rendermode InteractiveServer
@implements IDisposable
@using System.Text
@using ConfigForge.AspNet.RemoteInstances
@using ConfigForge.Core.Documents
@using ConfigForge.Core.Schema
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@inject IConfigForgeHostState State
@inject IJsonFormsSchemaParser Parser
@inject IConfigDocumentEngine Engine
@inject IConfigDocumentGenerator Generator
@inject ConfigSecretGateway Secrets
@inject IJSRuntime JS
@inject IServiceProvider Services

<div class="cf-host">
    @if (State.Options.ShowSchemaPicker && _schemaChoices.Count >= 1)
    {
        <div class="cf-host-toolbar">
            <label class="cf-host-field">
                <span>Schema</span>
                <select class="cf-input cf-select" value="@_selectedSchemaId" @onchange="OnSchemaSelectedAsync">
                    @if (_selectedSchemaId is null)
                    {
                        <option value="">Select a schema…</option>
                    }
                    @foreach (SchemaChoice choice in _schemaChoices)
                    {
                        <option value="@choice.Id">@choice.Label</option>
                    }
                </select>
            </label>
        </div>
    }

    @if (_loadError is not null)
    {
        <div class="cf-host-error" role="alert">@_loadError</div>
    }

    @if (_schema is not null)
    {
        <ConfigForgeShell @key="_loadGeneration"
                          Schema="_schema"
                          Document="_document"
                          ParseResult="_parseResult"
                          RawDocumentJson="_rawJson"
                          Mode="State.Options.Mode"
                          SchemaJson="@_schemaJson"
                          ShowCodePanel="State.Options.ShowCodePanel"
                          HeaderActions="State.Options.HeaderActions"
                          HideChrome="Fullscreen"
                          HideUnknownFieldsBanner="HideUnknownFieldsBanner"
                          ActiveCategoryKey="@_activeCategoryKey"
                          OnCategoryChanged="OnCategoryChangedAsync"
                          ActiveEntryKey="@_activeEntryKey"
                          OnEntryChanged="OnEntryChangedAsync"
                          OnSave="OnSaveAsync" />
    }
    else
    {
        <p class="cf-host-empty">No schema is available. Add a combined schema document to the configured schema directory, or select one above.</p>
    }
</div>

@code {
    private sealed record SchemaChoice(string Id, string Label, string? FilePath);

    /// <summary>
    /// Comma-separated <see cref="CategoryElement.EffectiveKey"/> values to hide from this page
    /// load only - the shared schema in <see cref="IConfigForgeHostState"/> is never mutated, so
    /// every other viewer keeps seeing the full category list. Meant for an embedding host (e.g.
    /// a native app shell) that wants a locked-down subset without a second, separately
    /// maintained schema.
    /// </summary>
    [SupplyParameterFromQuery]
    [Parameter]
    public string? HideCategories { get; set; }

    /// <summary>
    /// Comma-separated <see cref="CategoryElement.EffectiveKey"/> allowlist: only these
    /// categories render, everything else is dropped, for this page load only (same
    /// per-request scoping as <see cref="HideCategories"/>, which this is the inverse of - if
    /// both are set, a category must pass both filters). Meant for an embedding host that wants
    /// a single curated view (e.g. "just the Jobs and Logs categories") without a second,
    /// separately maintained schema.
    /// </summary>
    [SupplyParameterFromQuery]
    [Parameter]
    public string? ShowOnlyCategories { get; set; }

    /// <summary>
    /// Hides the header and sidebar chrome, showing only the active category's content
    /// edge-to-edge. Meant to be combined with <see cref="ShowOnlyCategories"/> naming exactly
    /// one category, for a single-purpose embed (e.g. a host application showing just one
    /// widget's own settings inline) - see <see cref="ConfigForgeShell.HideChrome"/>.
    /// </summary>
    [SupplyParameterFromQuery]
    [Parameter]
    public bool Fullscreen { get; set; }

    /// <summary>
    /// Suppresses the "N unrecognised fields" banner - see
    /// <c>ConfigForgeShell.HideUnknownFieldsBanner</c>. Meant for a curated
    /// <see cref="ShowOnlyCategories"/> embed that already knows it will not round-trip every
    /// field of the underlying document and does not want that surfaced as a warning.
    /// </summary>
    [SupplyParameterFromQuery]
    [Parameter]
    public bool HideUnknownFieldsBanner { get; set; }

    private readonly List<SchemaChoice> _schemaChoices = [];

    private string? _selectedSchemaId;
    private ConfigSchema? _schema;
    private ConfigDocument? _document;
    private ConfigDocumentParseResult? _parseResult;
    private string? _rawJson;
    private string? _schemaJson;
    private string? _loadError;
    private string? _activeCategoryKey;
    private string? _activeEntryKey;

    private int _loadGeneration;
    private DotNetObjectReference<ConfigForgePage>? _selfRef;
    private bool _hashWired;

    protected override async Task OnInitializedAsync()
    {
        BuildSchemaChoices();

        if (_schemaChoices.Count >= 1)
        {
            await SelectSchemaAsync(_schemaChoices[0]);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("configForgeHost.onHashChange", _selfRef);
        _hashWired = true;

        string slug = await JS.InvokeAsync<string>("configForgeHost.readHash");

        await InvokeAsync(() => ApplyHashSlug(slug));
    }

    /// <summary>Invoked from JS when the URL fragment changes (back/forward or manual edit).</summary>
    [JSInvokable]
    public Task OnHashChanged(string slug) => InvokeAsync(() => ApplyHashSlug(slug));

    private void ApplyHashSlug(string? slug)
    {
        if (_schema is null || string.IsNullOrEmpty(slug))
        {
            return;
        }

        // The fragment is "<category-slug>" or "<category-slug>/<entry-key>".
        string[] parts = slug.Split('/', 2);
        string? key = _schema
            .Categories.Select(c => c.EffectiveKey)
            .FirstOrDefault(k =>
                string.Equals(Slugify(k), parts[0], StringComparison.OrdinalIgnoreCase)
            );
        if (key is null)
        {
            return;
        }

        string? entryKey = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : null;
        bool changed = false;
        if (!string.Equals(key, _activeCategoryKey, StringComparison.Ordinal))
        {
            _activeCategoryKey = key;
            changed = true;
        }

        if (!string.Equals(entryKey, _activeEntryKey, StringComparison.Ordinal))
        {
            _activeEntryKey = entryKey;
            changed = true;
        }

        if (changed)
        {
            StateHasChanged();
        }
    }

    private async Task OnCategoryChangedAsync(string categoryKey)
    {
        _activeCategoryKey = categoryKey;
        await WriteHashAsync();
    }

    private async Task OnEntryChangedAsync(string? entryKey)
    {
        _activeEntryKey = entryKey;
        await WriteHashAsync();
    }

    private async Task WriteHashAsync()
    {
        if (!_hashWired || _activeCategoryKey is null)
        {
            return;
        }

        string hash = Slugify(_activeCategoryKey);
        if (_activeEntryKey is { Length: > 0 } entry && IsCollectionCategory(_activeCategoryKey))
        {
            hash += "/" + Uri.EscapeDataString(entry);
        }

        await JS.InvokeVoidAsync("configForgeHost.writeHash", hash);
    }

    private bool IsCollectionCategory(string categoryKey) =>
        _schema
            ?.Categories.FirstOrDefault(c =>
                string.Equals(c.EffectiveKey, categoryKey, StringComparison.Ordinal)
            )
            ?.CollectionKey
        is { Length: > 0 };

    private static string Slugify(string label)
    {
        StringBuilder builder = new(label.Length);
        bool lastDash = false;
        foreach (char c in label.Trim().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(c))
            {
                builder.Append(c);
                lastDash = false;
            }
            else if (!lastDash && builder.Length > 0)
            {
                builder.Append('-');
                lastDash = true;
            }
        }

        return builder.ToString().Trim('-');
    }

    private void BuildSchemaChoices()
    {
        _schemaChoices.Clear();

        if (State.Schemas.Count > 0)
        {
            foreach (ConfigSchema schema in State.Schemas.Values)
            {
                _schemaChoices.Add(new SchemaChoice(schema.Id, Label(schema.Id, schema.Name), null));
            }

            return;
        }

        foreach (SchemaChoice fileChoice in EnumerateSchemaFiles())
        {
            _schemaChoices.Add(fileChoice);
        }
    }

    private IEnumerable<SchemaChoice> EnumerateSchemaFiles()
    {
        string dir = ResolveSchemaDirectory();
        if (!Directory.Exists(dir))
        {
            yield break;
        }

        foreach (string path in Directory.EnumerateFiles(dir, "*.json"))
        {
            string id = Path.GetFileNameWithoutExtension(path);
            yield return new SchemaChoice(id, id, path);
        }
    }

    private string ResolveSchemaDirectory()
    {
        string configured = State.Options.SchemaDirectory;
        return Path.IsPathRooted(configured)
            ? configured
            : Path.Combine(AppContext.BaseDirectory, configured);
    }

    private static string Label(string id, string? name) =>
        string.IsNullOrEmpty(name) ? id : $"{name} ({id})";

    private async Task OnSchemaSelectedAsync(ChangeEventArgs e)
    {
        string? id = e.Value as string;
        SchemaChoice? choice = _schemaChoices.Find(c => c.Id == id);
        if (choice is not null)
        {
            await SelectSchemaAsync(choice);
        }
    }

    private async Task SelectSchemaAsync(SchemaChoice choice)
    {
        _loadError = null;
        _selectedSchemaId = choice.Id;

        try
        {
            _schema = ApplyShowOnlyCategories(ApplyHideCategories(ResolveSchema(choice)));
            string schemaPath =
                choice.FilePath ?? Path.Combine(ResolveSchemaDirectory(), $"{choice.Id}.json");
            _schemaJson = File.Exists(schemaPath) ? File.ReadAllText(schemaPath) : null;
        }
        catch (SchemaParseException ex)
        {
            _schema = null;
            _loadError = $"Could not parse schema '{choice.Id}': {ex.Message}";
            return;
        }

        await SeedInitialDocumentAsync();
        Bump();
    }

    private ConfigSchema ResolveSchema(SchemaChoice choice)
    {
        if (State.Schemas.TryGetValue(choice.Id, out ConfigSchema? cached))
        {
            return cached;
        }

        if (choice.FilePath is not null)
        {
            return Parser.ParseFromFile(choice.FilePath);
        }

        throw new SchemaParseException($"Schema '{choice.Id}' is no longer available.");
    }

    // Returns a new ConfigSchema instance with matching categories removed rather than mutating
    // the passed-in one, which for a cached schema is the exact same shared instance every other
    // viewer reads from (ResolveSchema above).
    private ConfigSchema ApplyHideCategories(ConfigSchema schema)
    {
        if (string.IsNullOrWhiteSpace(HideCategories))
        {
            return schema;
        }

        HashSet<string> hidden = new(
            HideCategories.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            StringComparer.Ordinal
        );
        if (hidden.Count == 0)
        {
            return schema;
        }

        return new ConfigSchema
        {
            Id = schema.Id,
            Name = schema.Name,
            Version = schema.Version,
            PluginId = schema.PluginId,
            Categories = [.. schema.Categories.Where(c => !hidden.Contains(c.EffectiveKey))],
            Fields = schema.Fields,
            Actions = schema.Actions,
            UntrackedKeys = schema.UntrackedKeys,
        };
    }

    // Same non-mutating-copy rationale as ApplyHideCategories above, inverted to an allowlist.
    private ConfigSchema ApplyShowOnlyCategories(ConfigSchema schema)
    {
        if (string.IsNullOrWhiteSpace(ShowOnlyCategories))
        {
            return schema;
        }

        HashSet<string> allowed = new(
            ShowOnlyCategories.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
            ),
            StringComparer.Ordinal
        );
        if (allowed.Count == 0)
        {
            return schema;
        }

        return new ConfigSchema
        {
            Id = schema.Id,
            Name = schema.Name,
            Version = schema.Version,
            PluginId = schema.PluginId,
            Categories = [.. schema.Categories.Where(c => allowed.Contains(c.EffectiveKey))],
            Fields = schema.Fields,
            Actions = schema.Actions,
            UntrackedKeys = schema.UntrackedKeys,
        };
    }

    private async Task SeedInitialDocumentAsync()
    {
        if (_schema is null)
        {
            return;
        }

        if (State.Options.OnLoad is not null)
        {
            string? persisted = await State.Options.OnLoad(_schema.Id);
            if (persisted is not null)
            {
                persisted = Secrets.RedactForEditor(_schema, persisted);
                ConfigDocumentParseResult result = Engine.Parse(persisted, _schema);
                Services.GetService<RemoteDocumentMergeService>()?.ApplyRemoteValues(result.Document);
                SetDocument(result.Document, result, persisted);
                return;
            }
        }

        SetDocument(Generator.GenerateExample(_schema), parseResult: null, rawJson: null);
    }

    private void SetDocument(ConfigDocument document, ConfigDocumentParseResult? parseResult, string? rawJson)
    {
        _document = document;
        _parseResult = parseResult;
        _rawJson = rawJson;
    }

    private async Task OnSaveAsync(ConfigDocument document)
    {
        if (_schema is null || State.Options.OnSave is null)
        {
            return;
        }

        RemoteDocumentMergeService? mergeService = Services.GetService<RemoteDocumentMergeService>();
        if (mergeService is not null)
        {
            RemoteDocumentSaveOutcome remoteOutcome = await mergeService.SplitAndSaveAsync(
                document,
                CancellationToken.None
            );
            if (!remoteOutcome.Success)
            {
                RemoteDocumentSaveFailure first = remoteOutcome.Failures[0];
                throw new InvalidOperationException(
                    $"Instance '{first.InstanceName}' rejected the save: {first.Error}"
                );
            }
        }

        string payload = Engine.Serialize(document, _schema);

        if (Secrets.Enabled && State.Options.OnLoad is not null)
        {
            string? stored = await State.Options.OnLoad(_schema.Id);
            payload = Secrets.MergeForStore(_schema, payload, stored);
        }

        await State.Options.OnSave(_schema.Id, payload);
    }

    private void Bump() => _loadGeneration++;

    /// <inheritdoc />
    public void Dispose() => _selfRef?.Dispose();
}
